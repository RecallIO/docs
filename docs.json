{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Recallio.AI Documentation",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.ico",
  "servers": [
    {
      "url": "https://app.recallio.ai/"
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Knowledge Base",
            "pages": [
              "index",
              "quickstart",
              "development"
            ]
          },
          {
            "group": "Memory Base",
            "pages": [
              "memory-overview",
              "memory-quickstart",
              "memory-deep-dive"
            ]
          },
          {
            "group": "Graph Memory Base",
            "pages": [
              "graph-memory-overview",
              "graph-memory-quickstart",
              "graph-memory-deep-dive"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "RecallIO.AI API",
            "openapi": {
              "source": "https://app.recallio.ai/swagger/v1/swagger.json",
              "directory": "api-reference"
            },
            "mdx": {
              "auth": {
                "method": "bearer"
              }
            }
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/logo_recallio.png",
    "dark": "/images/logo.png"
  },
  "modeToggle": {
    "default": "dark",
    "isHidden": true
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@recallio.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.recallio.ai"
    }
  },
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": true
    },
    "mdx": {
      "auth": {
        "method": "bearer"
      }
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/recallio"
    }
  }
}
